<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VeraDose: Pill & Medication Schedule Manager</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-main: #0a0d16;
            --bg-sidebar: rgba(15, 22, 38, 0.95);
            --bg-card: rgba(22, 32, 54, 0.75);
            --text-primary: #ffffff;
            --text-secondary: #9daec8;
            --accent-blue: #0088ff;
            --accent-cyan: #38bdf8;
            --border-dark: rgba(255, 255, 255, 0.1);
            --alert-red: #ef4444;
            --alert-yellow: #f59e0b;
            --alert-green: #10b981;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, sans-serif; }
        body { background-color: var(--bg-main); color: var(--text-primary); display: flex; min-height: 100vh; }
        .sidebar { width: 280px; background: var(--bg-sidebar); border-right: 1px solid var(--border-dark); padding: 24px; display: flex; flex-direction: column; gap: 20px; }
        .nav-item { padding: 12px 16px; border-radius: 8px; cursor: pointer; color: var(--text-secondary); display: flex; align-items: center; gap: 10px; margin-bottom: 6px; transition: 0.2s; }
        .nav-item.active, .nav-item:hover { background: var(--bg-card); color: var(--text-primary); font-weight: 600; }
        .main-content { flex-grow: 1; padding: 40px; overflow-y: auto; max-width: 1200px; }
        .page-view { display: none; }
        .page-view.active { display: block; }
        .card { background: var(--bg-card); border: 1px solid var(--border-dark); border-radius: 12px; padding: 24px; margin-bottom: 20px; }
        .btn { background: var(--accent-blue); color: #fff; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: 600; transition: 0.2s; }
        .btn:hover { background: var(--accent-cyan); color: #0a0d16; }
        .btn-secondary { background: rgba(255,255,255,0.1); color: #fff; border: 1px solid var(--border-dark); }
        .input-field { width: 100%; padding: 12px; background: rgba(0,0,0,0.3); border: 1px solid var(--border-dark); border-radius: 8px; color: #fff; margin-bottom: 14px; }
        .badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; }
        .badge-red { background: rgba(239, 68, 68, 0.2); color: var(--alert-red); border: 1px solid var(--alert-red); }
        .badge-green { background: rgba(16, 185, 129, 0.2); color: var(--alert-green); border: 1px solid var(--alert-green); }
        .badge-yellow { background: rgba(245, 158, 11, 0.2); color: var(--alert-yellow); border: 1px solid var(--alert-yellow); }
        .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; background: var(--bg-card); padding: 15px 24px; border-radius: 12px; border: 1px solid var(--border-dark); }
        .med-item { display: flex; justify-content: space-between; align-items: center; padding: 14px; background: rgba(0,0,0,0.2); border-radius: 8px; margin-bottom: 10px; border: 1px solid var(--border-dark); }
    </style>
</head>
<body data-lang="en">
    <aside class="sidebar">
        <h2>💊 VeraDose</h2>
        <p style="font-size: 0.85rem; color: var(--text-secondary);">Smart Medication Manager</p>
        <ul style="list-style: none; margin-top: 10px;">
            <li class="nav-item active" onclick="switchPage('schedule-page', this)"><i class="fa-solid fa-calendar-day"></i> <span data-i18n="nav_schedule">Today's Schedule</span></li>
            <li class="nav-item" onclick="switchPage('add-page', this)"><i class="fa-solid fa-plus-circle"></i> <span data-i18n="nav_add">Add Medication</span></li>
            <li class="nav-item" onclick="switchPage('scanner-page', this)"><i class="fa-solid fa-camera"></i> <span data-i18n="nav_scanner">Camera Bottle OCR</span></li>
            <li class="nav-item" onclick="switchPage('inventory-page', this)"><i class="fa-solid fa-pills"></i> <span data-i18n="nav_inventory">Inventory & Refills</span></li>
            <li class="nav-item" onclick="switchPage('visualizer-page', this)"><i class="fa-solid fa-magnifying-glass"></i> <span data-i18n="nav_visualizer">Pill Visualizer</span></li>
            <li class="nav-item" onclick="switchPage('safety-page', this)"><i class="fa-solid fa-shield-heart"></i> <span data-i18n="nav_safety">Interaction Checker</span></li>
        </ul>
    </aside>

    <main class="main-content">
        <!-- Top Control Bar: Streak, Language, Voice Assistant -->
        <div class="top-bar">
            <div style="display: flex; gap: 15px; align-items: center;">
                <span class="badge badge-yellow" id="streak-badge"><i class="fa-solid fa-fire"></i> <span id="streak-count">5</span> Day Streak 🔥</span>
                <span class="badge badge-green"><i class="fa-solid fa-circle-check"></i> System Secure</span>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
                <button class="btn btn-secondary" onclick="speakSchedule()"><i class="fa-solid fa-volume-high"></i> Read Aloud</button>
                <select class="input-field" style="width: auto; margin: 0; padding: 6px 12px;" onchange="changeLanguage(this.value)">
                    <option value="en">English</option>
                    <option value="es">Español</option>
                </select>
            </div>
        </div>

        <!-- Schedule Page -->
        <div id="schedule-page" class="page-view active">
            <h1>Today's Prescription Schedule</h1>
            <p style="color: var(--text-secondary); margin-bottom: 20px;">Track your daily doses, check food guidelines, and maintain your streak.</p>
            
            <div id="missed-alert-banner" style="display: none;" class="card" style="border-color: var(--alert-red);">
                <h3 style="color: var(--alert-red);"><i class="fa-solid fa-triangle-exclamation"></i> Missed Dose Alert</h3>
                <p style="color: var(--text-secondary); margin-top: 5px;">You have uncompleted scheduled medications past their due window.</p>
            </div>

            <div class="card">
                <h3>☀️ Morning Schedule</h3>
                <div id="morning-list" style="margin-top: 12px;">Loading...</div>
            </div>
            <div class="card">
                <h3>🌤️ Afternoon Schedule</h3>
                <div id="afternoon-list" style="margin-top: 12px;">Loading...</div>
            </div>
            <div class="card">
                <h3>🌙 Evening Schedule</h3>
                <div id="evening-list" style="margin-top: 12px;">Loading...</div>
            </div>
        </div>

        <!-- Add Medication Page -->
        <div id="add-page" class="page-view">
            <h1>Add New Medication</h1>
            <p style="color: var(--text-secondary); margin-bottom: 20px;">Manually enter pill details, daily dosages, and food instructions.</p>
            <div class="card" style="max-width: 600px;">
                <form id="add-med-form" onsubmit="submitMedication(event)">
                    <label>Medication Name</label>
                    <input type="text" id="med-name" class="input-field" placeholder="e.g., Lisinopril" required>
                    <label>Dosage</label>
                    <input type="text" id="med-dosage" class="input-field" placeholder="e.g., 10mg" required>
                    <label>Time Slot</label>
                    <select id="med-slot" class="input-field">
                        <option value="Morning">Morning</option>
                        <option value="Afternoon">Afternoon</option>
                        <option value="Evening">Evening</option>
                    </select>
                    <label>Starting Pill Count (Inventory)</label>
                    <input type="number" id="med-stock" class="input-field" value="30" required>
                    <label>Daily Doses Count</label>
                    <input type="number" id="med-daily" class="input-field" value="1" required>
                    <label>Food & Timing Guide</label>
                    <input type="text" id="med-food" class="input-field" placeholder="e.g., Take with food in the morning">
                    <button type="submit" class="btn">Save Medication</button>
                </form>
            </div>
        </div>

        <!-- Camera Scanner Page -->
        <div id="scanner-page" class="page-view">
            <h1>Pill Bottle Label OCR Scanner</h1>
            <p style="color: var(--text-secondary); margin-bottom: 20px;">Upload a prescription label photo to let AI extract medication data.</p>
            <div class="card" style="max-width: 600px; text-align: center; border: 2px dashed var(--accent-cyan);">
                <input type="file" id="bottle-upload" accept="image/*" style="display: none;" onchange="handleBottleUpload(event)">
                <button class="btn" onclick="document.getElementById('bottle-upload').click()"><i class="fa-solid fa-upload"></i> Upload Bottle Photo</button>
                <p id="scanner-results" style="margin-top: 15px; color: var(--text-secondary);">Waiting for image upload...</p>
            </div>
        </div>

        <!-- Inventory Page -->
        <div id="inventory-page" class="page-view">
            <h1>Pill Inventory & Low Stock Alerts</h1>
            <p style="color: var(--text-secondary); margin-bottom: 20px;">Track remaining pill counts and receive automated refill warnings.</p>
            <div class="card">
                <div id="inventory-list">Loading inventory...</div>
            </div>
        </div>

        <!-- Pill Visualizer Page -->
        <div id="visualizer-page" class="page-view">
            <h1>Pill Identification Visualizer</h1>
            <p style="color: var(--text-secondary); margin-bottom: 20px;">Verify physical pill characteristics (shape, color, imprint).</p>
            <div class="card" style="max-width: 600px;">
                <label>Pill Shape</label>
                <select id="pill-shape" class="input-field">
                    <option value="round">Round</option>
                    <option value="oval">Oval</option>
                </select>
                <label>Pill Color</label>
                <select id="pill-color" class="input-field">
                    <option value="white">White</option>
                    <option value="brown">Brown</option>
                </select>
                <label>Imprint Code (e.g., BAYER, MET 500)</label>
                <input type="text" id="pill-imprint" class="input-field" placeholder="Enter imprint">
                <button class="btn" onclick="identifyPill()">Search Pill Database</button>
                <div id="visualizer-result" style="margin-top: 15px; font-weight: 600; color: var(--accent-cyan);"></div>
            </div>
        </div>

        <!-- Safety & Interaction Checker Page -->
        <div id="safety-page" class="page-view">
            <h1>Drug Interaction & Safety Checker</h1>
            <p style="color: var(--text-secondary); margin-bottom: 20px;">AI-powered clinical check for active prescriptions.</p>
            <div class="card">
                <button class="btn" onclick="runSafetyCheck()"><i class="fa-solid fa-shield-heart"></i> Run AI Safety & Interaction Scan</button>
                <div id="safety-results" style="margin-top: 15px; color: var(--text-secondary); line-height: 1.6;">Click the button above to analyze active medications.</div>
            </div>
        </div>
    </main>

    <script>
        let allMedications = [];
        let translations = {
            en: { nav_schedule: "Today's Schedule", nav_add: "Add Medication", nav_scanner: "Camera Bottle OCR", nav_inventory: "Inventory & Refills", nav_visualizer: "Pill Visualizer", nav_safety: "Interaction Checker" },
            es: { nav_schedule: "Horario de Hoy", nav_add: "Añadir Medicamento", nav_scanner: "Escáner OCR", nav_inventory: "Inventario", nav_visualizer: "Visualizador de Pastillas", nav_safety: "Verificador de Interacciones" }
        };

        function switchPage(pageId, el) {
            document.querySelectorAll('.page-view').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            document.getElementById(pageId).classList.add('active');
            el.classList.add('active');
        }

        async function fetchMedications() {
            try {
                const res = await fetch('/api/medications');
                const data = await res.json();
                if (data.success) {
                    allMedications = data.medications;
                    renderSchedule();
                    renderInventory();
                }
            } catch (e) {
                console.error("Failed to load medications", e);
            }
        }

        function renderSchedule() {
            const slots = { Morning: document.getElementById('morning-list'), Afternoon: document.getElementById('afternoon-list'), Evening: document.getElementById('evening-list') };
            Object.values(slots).forEach(el => el.innerHTML = '<p style="color: var(--text-secondary);">No medications scheduled.</p>');

            let hasMissed = false;

            Object.keys(slots).forEach(slotName => {
                const medsInSlot = allMedications.filter(m => m.slot === slotName);
                if (medsInSlot.length > 0) {
                    slots[slotName].innerHTML = '';
                    medsInSlot.forEach(m => {
                        if (!m.taken) hasMissed = true;
                        slots[slotName].innerHTML += `
                            <div class="med-item">
                                <div>
                                    <b>${m.name}</b> (${m.dosage})<br>
                                    <span style="font-size: 0.85rem; color: var(--accent-cyan);">🍽️ ${m.food_guide}</span>
                                </div>
                                <div style="display: flex; gap: 10px; align-items: center;">
                                    <span class="badge ${m.taken ? 'badge-green' : 'badge-yellow'}">${m.taken ? 'Taken' : 'Pending'}</span>
                                    <button class="btn" style="padding: 6px 12px; font-size: 0.85rem;" onclick="toggleTaken(${m.id})">${m.taken ? 'Undo' : 'Mark Taken'}</button>
                                </div>
                            </div>
                        `;
                    });
                }
            });

            document.getElementById('missed-alert-banner').style.display = hasMissed ? 'block' : 'none';
        }

        function renderInventory() {
            const invDiv = document.getElementById('inventory-list');
            invDiv.innerHTML = '';
            allMedications.forEach(m => {
                let stockBadge = m.stock <= 5 ? '<span class="badge badge-red">⚠️ Low Stock</span>' : '<span class="badge badge-green">Stock OK</span>';
                invDiv.innerHTML += `
                    <div class="med-item">
                        <div>
                            <b>${m.name}</b> — ${m.stock} pills remaining (~${(m.stock / m.daily_dose).toFixed(1)} days left)
                        </div>
                        <div>${stockBadge}</div>
                    </div>
                `;
            });
        }

        async function toggleTaken(id) {
            const res = await fetch(`/api/medications/${id}/take`, { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                fetchMedications();
            }
        }

        async function submitMedication(event) {
            event.preventDefault();
            const payload = {
                name: document.getElementById('med-name').value,
                dosage: document.getElementById('med-dosage').value,
                slot: document.getElementById('med-slot').value,
                stock: parseInt(document.getElementById('med-stock').value),
                daily_dose: parseInt(document.getElementById('med-daily').value),
                food_guide: document.getElementById('med-food').value || 'Take as directed.'
            };

            const res = await fetch('/api/medications', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                alert('Medication saved successfully!');
                document.getElementById('add-med-form').reset();
                fetchMedications();
                switchPage('schedule-page', document.querySelector('.nav-item'));
            }
        }

        async function handleBottleUpload(event) {
            const file = event.target.files[0];
            if (!file) return;
            const resBox = document.getElementById('scanner-results');
            resBox.innerHTML = "⏳ Scanning bottle label with AI OCR...";

            const formData = new FormData();
            formData.append('file', file);

            try {
                const response = await fetch('/api/analyze', { method: 'POST', body: formData });
                const data = await response.json();
                if (data.success) {
                    resBox.innerHTML = `<b>Scan Successful!</b><br><pre style="text-align: left; margin-top: 10px; color: var(--accent-cyan);">${data.ocr_result}</pre>`;
                } else {
                    resBox.innerHTML = `<span style="color: #ef4444;">Error: ${data.error}</span>`;
                }
            } catch (err) {
                resBox.innerHTML = `<span style="color: #ef4444;">Failed to connect to backend server.</span>`;
            }
        }

        async function identifyPill() {
            const shape = document.getElementById('pill-shape').value;
            const color = document.getElementById('pill-color').value;
            const imprint = document.getElementById('pill-imprint').value;

            const res = await fetch('/api/identify-pill', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ shape, color, imprint })
            });
            const data = await res.json();
            const resDiv = document.getElementById('visualizer-result');
            if (data.matches.length > 0) {
                resDiv.innerHTML = `✅ Match Found: ${data.matches.join(', ')}`;
            } else {
                resDiv.innerHTML = `❌ No exact match found in database.`;
            }
        }

        async function runSafetyCheck() {
            const resDiv = document.getElementById('safety-results');
            resDiv.innerHTML = "🛡️ Running AI clinical interaction safety check...";
            const medNames = allMedications.map(m => m.name);

            const res = await fetch('/api/interactions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ medications: medNames })
            });
            const data = await res.json();
            if (data.success) {
                resDiv.innerHTML = `<div style="background: rgba(0,0,0,0.3); padding: 15px; border-radius: 8px; border-left: 4px solid var(--accent-cyan);">${data.analysis}</div>`;
            } else {
                resDiv.innerHTML = "Failed to run safety check.";
            }
        }

        function speakSchedule() {
            if (!('speechSynthesis' in window)) {
                alert('Text-to-speech is not supported by your browser.');
                return;
            }
            let text = "Here is your VeraDose schedule reminder. ";
            allMedications.forEach(m => {
                text += `Medication ${m.name}, dosage ${m.dosage}, scheduled for ${m.slot}. Food instruction: ${m.food_guide}. `;
            });
            const utterance = new SpeechSynthesisUtterance(text);
            window.speechSynthesis.speak(utterance);
        }

        function changeLanguage(lang) {
            document.body.setAttribute('data-lang', lang);
            const t = translations[lang];
            if (!t) return;
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (t[key]) el.innerText = t[key];
            });
        }

        // Initialize on load
        fetchMedications();
    </script>
</body>
#</html>

